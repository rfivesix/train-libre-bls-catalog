{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://train-libre.org/schemas/categories.schema.json",
  "title": "Train Libre food categories",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category_id", "names"],
        "properties": {
          "category_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "names": {
            "type": "object",
            "additionalProperties": false,
            "required": ["de", "en", "fr", "it", "ja"],
            "properties": {
              "de": {"type": "string", "minLength": 1},
              "en": {"type": "string", "minLength": 1},
              "fr": {"type": "string", "minLength": 1},
              "it": {"type": "string", "minLength": 1},
              "ja": {"type": "string", "minLength": 1}
            }
          },
          "emoji": {"type": "string"}
        }
      }
    }
  }
}
